# CareNet Healthcare Platform - Root Environment Example
# This file serves as a template for all microservices. 
# Copy specific sections to the .env file in each service directory.

# --- AUTH SERVICE ---
# Path: backend/auth-service/.env
AUTH_PORT=3001
AUTH_MONGO_URI=mongodb://localhost:27017/carenet_auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# --- APPOINTMENT SERVICE ---
# Path: backend/appointment-service/.env
APPOINTMENT_PORT=3004
APPOINTMENT_MONGO_URI=mongodb://localhost:27017/carenet_appointment
RABBITMQ_URL=amqp://localhost:5672

# --- NOTIFICATION SERVICE ---
# Path: backend/notification-service/.env
NOTIFICATION_PORT=3006
NOTIFICATION_MONGO_URI=mongodb://localhost:27017/carenet_notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Healthcare Platform <noreply@healthcare.com>

# --- PAYMENT SERVICE ---
# Path: backend/payment-service/.env
PAYMENT_PORT=3005
PAYMENT_MONGO_URI=mongodb://localhost:27017/carenet_payments
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_secret

# --- AI SYMPTOM SERVICE ---
# Path: backend/ai-symptom-service/.env
GEMINI_API_KEY=your_gemini_api_key

# --- API GATEWAY ---
# Path: backend/api-gateway/.env
GATEWAY_PORT=8080

# --- FRONTEND ---
# Path: frontend/.env
VITE_API_BASE_URL=http://localhost:8080/api
