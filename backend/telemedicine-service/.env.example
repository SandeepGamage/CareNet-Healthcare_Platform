PORT=3007
MONGO_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/carenet_db?appName=Cluster0
JWT_SECRET=your_jwt_secret_here
APPOINTMENT_SERVICE_URL=http://localhost:3004
JITSI_PROVIDER=jaas
JITSI_DOMAIN=8x8.vc
JITSI_ENFORCE_JWT=true
JITSI_APP_ID=vpaas-magic-cookie-your-app-id
JITSI_KEY_ID=your-jaas-key-id
JAAS_PRIVATE_KEY_PATH=/keys/jaas_private_key.pem
# Optional inline fallback:
# JITSI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_JAAS_PRIVATE_KEY\n-----END PRIVATE KEY-----
NODE_ENV=development
