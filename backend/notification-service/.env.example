PORT=5004
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/healthcare_notifications

# JWT (shared secret with other services for internal auth)
JWT_SECRET=your_jwt_secret_here

# Email - Nodemailer (Gmail / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="Healthcare Platform <no-reply@healthcare.com>"

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Internal service auth token
INTERNAL_SERVICE_TOKEN=your_internal_service_token
